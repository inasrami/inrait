diff --git a/src/composables/useScrollScene.js b/src/composables/useScrollScene.js
new file mode 100644
index 0000000..d7c5342
--- /dev/null
+++ b/src/composables/useScrollScene.js
@@ -0,0 +1,120 @@
+import { onMounted, onBeforeUnmount } from 'vue'
+
+/**
+ * Scroll scenes
+ * -------------
+ * Writes a 0 → 1 progress value to a `--p` CSS variable on the scene element,
+ * so all the visual work stays in CSS (transform / opacity only).
+ *
+ *  type: 'pin'   – element is a TALL wrapper whose first child is `position: sticky`.
+ *                  p = how far you have scrolled through the pinned stretch.
+ *                  The class `is-pinned` is toggled on the wrapper, so the CSS can
+ *                  ship a normal, un-pinned layout as the default (no JS, reduced
+ *                  motion, very short screens) and only enhance it when pinning is on.
+ *  type: 'leave' – p = how far the element has scrolled out of view (0 at the top
+ *                  of the page, 1 once it has fully left). Used for the hero parallax.
+ *
+ *  measure(el)   – optional hook, called after `is-pinned` is applied and on resize,
+ *                  for scenes that need to size themselves (e.g. horizontal distance).
+ */
+
+const scenes = new Set()
+let ticking = false
+let listening = false
+
+function tick() {
+  ticking = false
+  scenes.forEach((s) => s.update())
+}
+
+function schedule() {
+  if (ticking) return
+  ticking = true
+  requestAnimationFrame(tick)
+}
+
+function onResize() {
+  scenes.forEach((s) => s.remeasure())
+  schedule()
+}
+
+function attach() {
+  if (listening) return
+  window.addEventListener('scroll', schedule, { passive: true })
+  window.addEventListener('resize', onResize)
+  listening = true
+}
+
+function detach() {
+  if (!listening || scenes.size) return
+  window.removeEventListener('scroll', schedule)
+  window.removeEventListener('resize', onResize)
+  listening = false
+}
+
+export function useScrollScene(elRef, { type = 'pin', measure } = {}) {
+  let scene = null
+  let cleanup = []
+
+  onMounted(() => {
+    const el = elRef.value
+    if (!el) return
+
+    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
+    const short = window.matchMedia('(max-height: 560px)')
+    const enabled = () => !reduced.matches && (type === 'leave' || !short.matches)
+
+    let last = -1
+
+    scene = {
+      remeasure() {
+        const on = enabled()
+        if (type === 'pin') el.classList.toggle('is-pinned', on)
+        if (on && measure) measure(el)
+        last = -1
+        this.update()
+      },
+      update() {
+        if (!enabled()) {
+          // Pin scenes rest on their finished state, leave scenes on their start state.
+          el.style.setProperty('--p', type === 'pin' ? '1' : '0')
+          return
+        }
+        const rect = el.getBoundingClientRect()
+        let p = 0
+        if (type === 'pin') {
+          const stick = el.firstElementChild
+          const range = stick ? el.offsetHeight - stick.offsetHeight : 0
+          p = range > 0 ? -rect.top / range : 0
+        } else {
+          p = -rect.top / Math.max(rect.height, 1)
+        }
+        p = Math.min(1, Math.max(0, p))
+        if (p === last) return
+        last = p
+        el.style.setProperty('--p', p.toFixed(4))
+      },
+    }
+
+    scenes.add(scene)
+    attach()
+    scene.remeasure()
+
+    const onChange = () => scene.remeasure()
+    reduced.addEventListener('change', onChange)
+    short.addEventListener('change', onChange)
+    cleanup = [
+      () => reduced.removeEventListener('change', onChange),
+      () => short.removeEventListener('change', onChange),
+    ]
+  })
+
+  onBeforeUnmount(() => {
+    cleanup.forEach((fn) => fn())
+    if (scene) scenes.delete(scene)
+    scene = null
+    detach()
+  })
+
+  return { remeasure: () => scene?.remeasure() }
+}
